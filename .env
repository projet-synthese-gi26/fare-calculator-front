# ===========================================
# CONFIGURATION ENVIRONNEMENT - FARE CALCULATOR PWA
# ===========================================
# Copier ce fichier en .env et remplacer les valeurs

# ---------------------------------------------
# API BACKEND DJANGO REST FRAMEWORK
# ---------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
# Clé API générée depuis l'interface d'administration Django
VITE_API_KEY=974e9428-6ce2-48e7-b74b-93f572007ef8

# ---------------------------------------------
# MAPBOX API (Cartes, Routing, Geocoding)
# ---------------------------------------------
# Obtenir une clé gratuite psur https://account.mapbox.com/
# Quota gratuit : 100k requêtes/mois pour Directions, Matrix, Isochrone, Search
VITE_MAPBOX_TOKEN=k.eyJ1IjoibTJnaSIsImEiOiJjbWhramlqcnIwYW5rMmlzY3ViZmg1NGFmIn0.q3XQxQTte7ADbn32fwFh-g

# Style de carte Mapbox (optionnel - défaut: streets-v12)
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# ---------------------------------------------
# NOMINATIM API (Geocoding Fallback OpenStreetMap)
# ---------------------------------------------
# API gratuite pour reverse geocoding et recherche POI (fallback si Mapbox échoue)
# Rate limit : 1 req/sec - respecté via cache
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---------------------------------------------
# OPEN-METEO API (Météo Gratuite)
# ---------------------------------------------
# API météo gratuite pour fallbacks auto-détection météo
VITE_OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ---------------------------------------------
# CONFIGURATION PWA
# ---------------------------------------------
# Mode production/développement (dev = sans service worker offline)
VITE_MODE=development

# ---------------------------------------------
# PARAMÈTRES FONCTIONNELS
# ---------------------------------------------
# Activer géolocalisation auto au démarrage (true/false)
VITE_ENABLE_GEOLOCATION=true

# Cache TTL en millisecondes (ex: 3600000 = 1h)
VITE_CACHE_TTL=3600000

# Timeout API en millisecondes
VITE_API_TIMEOUT=30000

# ---------------------------------------------
# ANALYTICS (OPTIONNEL)
# ---------------------------------------------
# Google Analytics ID (optionnel)
# VITE_GA_ID=G-XXXXXXXXXX

